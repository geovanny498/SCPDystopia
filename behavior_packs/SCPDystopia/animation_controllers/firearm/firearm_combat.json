          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:suscharger') == 0"
            }
          ]
        },
        "m16": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:m16"
