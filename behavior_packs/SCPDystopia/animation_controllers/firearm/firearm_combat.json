          ]
        },
        "scar": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:scar"
          ],
          "on_exit": ["/event entity @s humanoid:firearm_combat:lost_weapon"],
          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:scar') == 0"
            }
          ]
        },
        "dtrifle": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:dtrifle"
          ],
          "on_exit": ["/event entity @s humanoid:firearm_combat:lost_weapon"],
          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:dtrifle') == 0"
            }
          ]
        },
        "ak47": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:ak47"
          ],
          "on_exit": ["/event entity @s humanoid:firearm_combat:lost_weapon"],
          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:ak47') == 0"
            }
          ]
        },
        "mp7": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:mp7"
          ],
          "on_exit": ["/event entity @s humanoid:firearm_combat:lost_weapon"],
          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:mp7') == 0"
            }
          ]
        },
        "mp5a3": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:mp5a3"
          ],
          "on_exit": ["/event entity @s humanoid:firearm_combat:lost_weapon"],
          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:mp5a3') == 0"
            }
          ]
        },
        "p90": {
          "on_entry": [
            "/playsound scpdt.firearm_combat.equip_firearm @a[r=20] ~~~",
            "/event entity @s humanoid:firearm_combat:equip_gun:p90"
          ],
          "on_exit": ["/event entity @s humanoid:firearm_combat:lost_weapon"],
          "transitions": [
            {
              "default": "q.equipped_item_any_tag('slot.weapon.mainhand', 'lc:firearm:p90') == 0"
            }
          ]
        }

        /* #endregion */
      }
    }
  }
}
