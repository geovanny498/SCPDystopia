{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2020", "dom"],
    "moduleResolution": "Node",
    // "ignoreDeprecations": "6.0",
    "module": "ES2020",
    "declaration": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "pretty": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitUseStrict": false,
    "outDir": "lib",
    "rootDir": ".",
    "listFiles": false,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["scripts/**/*"],
  "exclude": ["lib", "dist", "node_modules"],
  "compileOnSave": false
}
