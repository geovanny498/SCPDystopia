{
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "git.ignoreLimitWarning": true,
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/lib": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        // "**/node_modules/*": true,
        // "**/node_modules/@minecraft/**": false,
    },
    "cSpell.words": [
        "gametest",
        "gametests",
        "mcaddon",
        "minecart",
        "shulker",
        "zoglin"
    ],
    "editor.tabSize": 2,
    "eslint.experimental.useFlatConfig": true,
    "editor.guides.bracketPairs": "active",
    "files.autoSave": "afterDelay",
    "editor.formatOnSave": true,
    // "BC-MC.Diagnostics.Lang": false,
    "files.encoding": "utf8"
}