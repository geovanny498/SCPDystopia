{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.ignoreLimitWarning": true,
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/lib": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true
    // "**/node_modules/*": true,
    // "**/node_modules/@minecraft/**": false,
  },
  "cSpell.words": ["gametest", "gametests", "mcaddon", "minecart", "shulker", "zoglin"],
  "editor.tabSize": 2,
  "eslint.experimental.useFlatConfig": true,
  "editor.guides.bracketPairs": "active",
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "BC-MC.Diagnostics.Lang": false,
  "files.encoding": "utf8",
  "[bc-mcfunction]": {
    "editor.defaultFormatter": "BlockceptionLtd.blockceptionvscodeminecraftbedrockdevelopmentextension"
  },
  "js/ts.tsdk.path": "node_modules\\typescript\\lib",
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  }
  //   "prettier.requireConfig": true,
  //   "prettier.configPath": ".prettierrc.json"
}
