{
    "format_version": "1.10",
    "minecraft:attachable": {
        "description": {
            "identifier": "lc:dt_ak47_empty",
            "materials": {
                "first_person": "entity_emissive_alpha",
                "third_person": "entity_emissive_alpha_one_sided"
            },
            "textures": {
                "default": "textures/scpdt_de/Firearms/ak47"
            },
            "geometry": {
                "first_person_default": "geometry.scpdt_de.firearm.ak47.first_person",
                "third_person_default": "geometry.scpdt_de.firearm.ak47.third_person", // LOD 0
                "third_person_lod_1": "geometry.scpdt_de.firearm.ak47.third_person.lod_1", // LOD 1
                "third_person_lod_2": "geometry.scpdt_de.firearm.ak47.third_person.lod_2", // LOD 2
                "third_person_lod_3": "geometry.scpdt_de.firearm.ak47.third_person.lod_3", // LOD 3
                "third_person_culled": "geometry.scpdt_de.misc.none" // LOD 4 (Culled)
            },
            "animations": {
                "controller": "controller.animation.scpdt_de.firearm.ak47.empty",

                "picking": "animation.scpdt_de.firearm.ak47.picking",
                "holding": "animation.scpdt_de.firearm.ak47.holding",
                "to_ads": "animation.scpdt_de.firearm.ak47.to_ads",
                "holding_ads": "animation.scpdt_de.firearm.ak47.holding_ads",
                "quitting_ads": "animation.scpdt_de.firearm.ak47.quitting_ads",
                "shooting": "animation.scpdt_de.firearm.ak47.shooting",
                "shooting_ads": "animation.scpdt_de.firearm.ak47.shooting_ads",
                "reloading": "animation.scpdt_de.firearm.ak47.reloading"
            },
            "scripts": {
                "animate": [
                    "controller"
                ],
                "pre_animation": [
                    "variable.perspective = c.is_first_person;",
                    "variable.lod_index = query.lod_index(10, 20, 30, 40);"
                ]
            },
            "particle_effects": {
              "fire": "lc:dt_muzzleflash_emitter"
            },
            "render_controllers": [
                {
                    "controller.render.scpdt_de.3d_item.first_person": "c.is_first_person"
                },
                {
                    "controller.render.scpdt_de.3d_item.third_person.four_step_lod": "!c.is_first_person"
                }
            ]
        }
    }
}