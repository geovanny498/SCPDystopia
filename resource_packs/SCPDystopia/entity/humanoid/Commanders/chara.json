{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "lc:dt_chara",
      "materials": {
        "default": "npc"
      },
      "textures": {
        "chara": "textures/entity/humanoid/Commanders/chara",
        "chara1": "textures/entity/humanoid/Commanders/chara1",
        "chara2": "textures/entity/humanoid/Commanders/chara2",
        "chara3": "textures/entity/humanoid/Commanders/chara3"
      },
      "geometry": {
        "default": "geometry.humanoid.slim.base"
      },
      "animations": {
        // Animation Controllers
        "controller": "controller.animation.scpdt_de.humanoid",
        // Base humanoid animations
        "idling": "animation.scpdt_de.humanoid.idling",
        "moving_legs": "animation.scpdt_de.humanoid.moving_legs",
        "moving_arms": "animation.scpdt_de.humanoid.moving_arms",
        "melee_attacking": "animation.scpdt_de.humanoid.melee_attacking",
        "looking_at_target": "animation.scpdt_de.humanoid.looking_at_target",
        // Unique humanoid animations
        "guarding_pistol": "animation.scpdt_de.humanoid.guarding_pistol",
        "guarding": "animation.scpdt_de.humanoid.guarding",
        "aiming_gun_pistol": "animation.scpdt_de.humanoid.aiming_gun_pistol",
        "aiming_gun": "animation.scpdt_de.humanoid.aiming_gun",
        "reloading_gun_pistol": "animation.scpdt_de.humanoid.reloading_gun_pistol",
        "reloading_gun": "animation.scpdt_de.humanoid.reloading_gun",
        "melee_attacking_gun_pistol": "animation.scpdt_de.humanoid.melee_attacking_gun_pistol",
        "melee_attacking_gun": "animation.scpdt_de.humanoid.melee_attacking_gun"
      },
      "scripts": {
        "scale": "0.9375",
        "animate": ["controller"],
        "pre_animation": [
          "variable.move_multiplier = 0.9;",
          "variable.move = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.look_rotation_multiplier = 1.0;",
          "variable.idling_speed = 70;"
        ]
      },
      "render_controllers": ["controller.render.chara"],
      "spawn_egg": {
        "base_color": "#4a2c2c",
        "overlay_color": "#8400FF"
      },
      "enable_attachables": true
    }
  }
